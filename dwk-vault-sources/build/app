function spotifyEmbed(url){
 if(!url) return null;
 const u=String(url).trim();
 let m=u.match(/spotify\.com\/(?:intl-[a-z]+\/)?(playlist|album|track|artist|episode|show)\/([A-Za-z0-9]+)/);
 if(!m) m=u.match(/^spotify:(playlist|album|track|artist|episode|show):([A-Za-z0-9]+)$/);
 return m?`https://open.spotify.com/embed/${m[1]}/${m[2]}?theme=0`:null;
}
