<script>

const $=id=>document.getElementById(id);
const fmt=s=>s==null?'—:—:—':[Math.floor(s/3600),Math.floor(s%3600/60),Math.floor(s%60)].map(v=>String(v).padStart(2,'0')).join(':');
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const CARDKEYS=[['changed','What Changed'],['learned','What We Learned'],['who','Who Mattered'],['cost','What It Cost'],['hanging',"What's Still Hanging"]];
const LABEL={scene:'Scene',combat:'Combat',magic:'Magic',dread:'Dread',lore:'Lore',clue:'Clue',item:'Item',boss:'Boss',reveal:'Reveal',rule:'Ruling',social:'Social',travel:'Travel',plan:'Planning'};
const HUE={scene:'#7d9cb0',combat:'#e07a45',magic:'#a48ac9',dread:'#a06b7c',lore:'#c39a4e',clue:'#6b8f6b',item:'#c39a4e',boss:'#c0503b',reveal:'#8fb2cc',rule:'#9a9086',social:'#c9a06b',travel:'#8aa89a',plan:'#9a9086'};
const MOOD={scene:['#0c1114','#12191d'],combat:['#150b08','#20100a'],magic:['#0e0b16','#171022'],dread:['#110b0d','#190e12'],lore:['#0f0e09','#181510'],clue:['#090f0e','#0f1a17'],item:['#120f08','#1d180d'],boss:['#160708','#220b0d'],reveal:['#0b0e13','#111620'],rule:['#0d0d0f','#151517'],social:['#120e0a','#1c150f'],travel:['#0b1010','#121a19'],plan:['#0d0d0e','#161615']};

/* ═══════ HOME ═══════ */
const withTC=SESSIONS.filter(s=>s.hasTimecodes).length;
const totalSec=SESSIONS.reduce((a,s)=>a+(s.durationSec||0),0);
$('h-eyebrow').textContent=`Campaign Archive · ${SESSIONS[SESSIONS.length-1].pretty} — ${SESSIONS[0].pretty}`;
$('h-stats').innerHTML=[
 [SESSIONS.length,'Sessions'],
 [Math.floor(totalSec/3600)+'h '+Math.round(totalSec%3600/60)+'m','At the table'],
 [SESSIONS.reduce((a,s)=>a+s.beats.length,0),'Moments'],
 [Object.keys(codexIndex()).length,'Codex entries'],
 [SESSIONS.reduce((a,s)=>a+s.threads.length,0),'Open threads'],
 [SESSIONS.filter(s=>s.audio).length,'With audio']
].map(([b,s])=>`<div class="stat"><b>${b}</b><span>${s}</span></div>`).join('');
$('h-count').textContent='Newest first';

$('h-built').textContent=(typeof BUILD!=='undefined'?BUILD:'unknown');
$('h-list').innerHTML=SESSIONS.map((s,i)=>
 `<li><a onclick="openS(${i})">
   <span class="rn">${String(s.n).padStart(2,'0')}</span>
   <span><span class="rt">${AUDIO_URLS[s.slug]?'<i class="rp" title="There is a recording of this one"><svg viewBox="0 0 11 13" aria-hidden="true">'
       +'<rect x="0" y="4.5" width="1.5" height="4" rx=".75"/>'
       +'<rect x="3.75" y="1" width="1.5" height="11" rx=".75"/>'
       +'<rect x="7.5" y="3" width="1.5" height="7" rx=".75"/></svg></i>':''}${esc(s.subtitle||s.title)}</span><span class="rl">${esc(s.logline||'')}</span></span>
   <span class="rm">${s.pretty} · ${esc(s.runtime||'')}</span>
   <span class="rtag">${s.audio?'<span class="tg a">◉ audio</span>':''}${s.hasTimecodes?(s.timecodesReliable===false?'<span class="tg l">times suspect</span>':'<span class="tg t">deep-linked</span>'):'<span class="tg">summary</span>'}${s.legendary?'<span class="tg l">legendary</span>':''}</span>
  </a></li>`).join('');
$('h-note').innerHTML=`<b>${withTC} of ${SESSIONS.length} sessions are deep-linked</b> — those recordings carry timecodes, so every fact clicks through to the audio.<br>
The rest are marked <b>summary</b>: Notta generated them with its generic template instead of the D&D one, so the detail is there but the timecodes are not.<br>
Re-running the D&D template on those sessions in Notta would upgrade them in place. The vault will pick it up automatically.`;

/* ═══════ SESSION ═══════ */
let CUR=0;
function openS(i){
 CUR=i; const s=SESSIONS[i];
 $('s-num').textContent=`Session ${s.n} · ${s.pretty}`;
 ed($('s-title'),s.title,i,'title');
 ed($('s-sub'),s.subtitle||'',i,'subtitle');
 ed($('s-log'),s.logline||'',i,'logline');
 const v=[['Runtime',s.runtime],['Dungeon Master',s.dm,'dm'],['Opens',s.opens,'opens'],['Closes',s.closes,'closes'],
  ['Party',(s.party||[]).join(' · '),'party'],
  ['Audio',s.audio?(AUDIO_URLS[s.slug]?'Ready · test ▸':'File not linked yet'):'Not in this batch','__audio'],
  ['Timecodes',s.hasTimecodes?(s.timecodesReliable===false?'Present, but unreliable':'Yes — deep-linked'):'No — summary only']].filter(r=>r[1]);
 $('s-vitals').innerHTML=v.map(([a,b,k])=>{
   if(k==='__audio'&&AUDIO_URLS[s.slug])
     /* this used to link the raw file, so one tap started a 100 MB download
        instead of playing anything */
     return `<div class="vit"><span>${a}</span><b><button class="vitlink" onclick="listen(${i},0)">Ready · play it &#9654;</button></b></div>`;
   return `<div class="vit"><span>${a}</span><b${k&&k!=='__audio'?` data-e="${i}|${k}"`:''}>${esc(b)}</b></div>`;
  }).join('');
 const canPlay=!!AUDIO_URLS[s.slug];
 buildSessionListen(i);
 buildShape(i);

 renderPreviously(i);
 const tcWarn=$('s-tcwarn');
 if(s.hasTimecodes&&s.timecodesReliable===false){
  tcWarn.style.display='block';
  tcWarn.innerHTML="<b>Heads up on this one.</b> Notta stamped several later moments with sub-one-minute timecodes, so the times below don't all line up with when things actually happened. The moments are in true story order; the timecodes are shown as recorded and shouldn't be trusted for jumping the audio.";
 } else tcWarn.style.display='none';
