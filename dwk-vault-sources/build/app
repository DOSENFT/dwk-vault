function editMeta(name,field){
 const m=metaOf(name);
 const ask={sub:'What sits under their name.\n\nClass, title, station — whatever the table would say if asked "who is that?"',
  blurb:"One line, in your words.\n\nThis is the only writing in the vault that isn't the recording's. Leave it empty if you'd rather it stay bare.",
  truename:'A true name, if the table has learned one.\n\nIt stays folded away under “What the table knows” — never on the front of the page.'}[field];
 const v=prompt(ask,m[field]||''); if(v===null)return;
 pushEdit('pc_meta',{name,field,value:v.trim()}); openE(name);
}
/* One life, in the order it happened. Read twice on a character's own page —
   once as the strip across the top, once as the arc below it — so both are
   telling the same story by construction. */
const ARCCACHE=new Map();
function arcOf(e){
 const key=e.name.toLowerCase()+'|'+SESSIONS.length;
 if(ARCCACHE.has(key)) return ARCCACHE.get(key);
 const names=[e.name,...[...e.aliases]].map(n=>n.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'));
 const rx=new RegExp('\\b('+names.join('|')+')\\b','i');
 const chapters=[];
 SESSIONS.slice().sort((a,b)=>a.n-b.n).forEach(s=>{
  const si=SESSIONS.indexOf(s);
  const notes=(s.entities||[]).filter(x=>e.hits.some(h=>h.s===s&&h.e===x))
    .map(x=>({t:x.t,txt:(x.note||'').trim()})).filter(x=>x.txt);
  const moments=s.beats.filter(b=>rx.test(b.title)||rx.test(b.line)||(b.facets||[]).some(f=>rx.test(f[1])));
  if(!notes.length&&!moments.length) return;
  /* the headline is the strongest thing said about them that night; it is
     never repeated inside the fold underneath itself */
  const head=(notes[0]&&notes[0].txt)||(moments[0]&&(moments[0].title+' — '+moments[0].line))||'';
  chapters.push({s,si,notes,moments,head});
 });
 ARCCACHE.set(key,chapters);
 return chapters;
}

/* ── the shape of one night ─────────────────────────────────────────────
   One tick per moment, placed where it actually happened in the recording
   and coloured by what kind of moment it was. Three hours becomes a picture:
   you can see a session open social, turn gold with lore and end in a
   blood-dark run before you have read a word of it. No legend — a legend for
   thirteen kinds would be the clutter. Touch a tick and it names itself. */
function buildShape(i){
 const el=$('s-shape'), s=SESSIONS[i]; if(!el)return;
 const B=s.beats||[];
 if(B.length<4){ el.innerHTML=''; return; }
 const useT=s.hasTimecodes&&s.durationSec&&s.timecodesReliable!==false;
 const peak=Math.max(1,...B.map(b=>(b.facets||[]).length));
 SHAPE=B;
 el.innerHTML=`<div class="shaperule"></div>`
  +B.map((b,k)=>{
   const x=useT&&b.t!=null ? (b.t/s.durationSec*100) : (k/(B.length-1||1)*100);
   const h=8+Math.round(Math.min(1,(b.facets||[]).length/peak)*16);
   return `<button class="shk" data-i="${k}" style="left:${x.toFixed(2)}%;--h:${h}px;--c:${HUE[b.kind]||'#9a9086'}"
     onclick="shTap(${k})" onmouseenter="shPop(${k})" onfocus="shPop(${k})"
     aria-label="${esc(LABEL[b.kind]||b.kind)} at ${fmt(b.t)} — ${esc(trim(b.title,80))}"><i></i></button>`;
  }).join('')
  +`<div class="smkpop" id="s-pop" hidden></div>
    <div class="stripfoot"><span>${useT?'00:00:00':'Opens'}</span>
      <span>${B.length} moments · colour is the kind of moment</span>
      <span>${useT?fmt(s.durationSec):'Closes'}</span></div>`;
}
let SHAPE=[], SHARMED=-1;
function shPop(k,sticky){
 const b=SHAPE[k], pop=$('s-pop'), strip=$('s-shape'); if(!b||!pop)return;
 pop.innerHTML=`<b style="color:${HUE[b.kind]||'var(--rust-l)'}">${esc(LABEL[b.kind]||b.kind)}${b.t!=null?' · '+fmt(b.t):''}</b>`
  +`${esc(trim(b.title+' — '+b.line,170))}`;
 pop.hidden=false;
 const mk=strip.querySelector(`.shk[data-i="${k}"]`);
 strip.querySelectorAll('.shk').forEach(m=>m.classList.toggle('on',m===mk));
 const sw=strip.clientWidth, pw=Math.min(340,sw-8);
 pop.style.width=pw+'px';
 pop.style.left=Math.max(4,Math.min(sw-pw-4,mk.offsetLeft-pw/2))+'px';
}
function shHide(){ const p=$('s-pop'); if(p)p.hidden=true;
 const st=$('s-shape'); if(st) st.querySelectorAll('.shk').forEach(m=>m.classList.remove('on'));
 SHARMED=-1; }
function shTap(k){
 const fine=matchMedia('(hover:hover)').matches;
 if(fine||SHARMED===k){ const b=SHAPE[k]; shHide();
  if(b&&b.t!=null&&AUDIO_URLS[SESSIONS[CUR].slug]){ jump(CUR,b.t); openReel(); }
  else { openReel(); paintBeat(k); scrollToBeat(k,true); }
  return; }
 SHARMED=k; shPop(k,true);
}

/* ── their story as a strip ──────────────────────────────────────────────
   One mark per night this person is in, laid along the whole campaign, and
   the taller the mark the more happened to them then. It answers the
   question the arc list below cannot: where were this person's big nights?
   Hover a mark and it tells you what it was. Tap it and you land there. */
function stripFor(chapters){
 if(chapters.length<2) return '';
 const first=SESSIONS.reduce((a,s)=>Math.min(a,s.n),1e9);
 const last =SESSIONS.reduce((a,s)=>Math.max(a,s.n),0);
 const span=Math.max(1,last-first);
 /* scaled inside this one life — never against anybody else's */
 const peak=Math.max(...chapters.map(c=>c.notes.length+c.moments.length));
 return `<div class="strip" id="e-strip">
  <div class="striprule"></div>
  ${chapters.map((c,ci)=>{
   const w=c.notes.length+c.moments.length;
   const h=(9+Math.round(Math.min(1,w/peak)*23));
   return `<button class="smk" data-i="${ci}" style="left:${((c.s.n-first)/span*100).toFixed(2)}%;--h:${h}px"
     onclick="mkTap(${ci},${c.s.n})"
     onmouseenter="mkPop(${ci})" onfocus="mkPop(${ci})"
     aria-label="Session ${c.s.n}: ${esc(trim(c.head,90))}"><i></i></button>`;
  }).join('')}
  <div class="smkpop" id="e-pop" hidden></div>
  <div class="stripfoot"><span>Session ${first}</span><span id="e-striphint">Taller means more happened that night</span><span>Session ${last}</span></div>
 </div>`;
}
let STRIP=[], MKARMED=-1;
function mkPop(ci,sticky){
 const c=STRIP[ci]; const pop=$('e-pop'), strip=$('e-strip'); if(!c||!pop)return;
 pop.innerHTML=`<b>Session ${c.s.n} · ${esc(c.s.pretty)}</b>${esc(trim(c.head,170))}`;
 pop.hidden=false;
 const mk=strip.querySelector(`.smk[data-i="${ci}"]`);
 strip.querySelectorAll('.smk').forEach(m=>m.classList.toggle('on',m===mk));
 /* keep it inside the strip rather than off the edge of a phone */
 const sw=strip.clientWidth, pw=Math.min(320,sw-8);
 pop.style.width=pw+'px';
 const x=mk.offsetLeft;
 pop.style.left=Math.max(4,Math.min(sw-pw-4,x-pw/2))+'px';
 clearTimeout(mkPop._t);
 if(!sticky) mkPop._t=setTimeout(()=>{},0);
}
function mkHide(){ const pop=$('e-pop'); if(pop){ pop.hidden=true; }
 const strip=$('e-strip'); if(strip) strip.querySelectorAll('.smk').forEach(m=>m.classList.remove('on'));
 MKARMED=-1; }
/* first tap shows what the mark is, second tap goes there — so a thumb can
   read the strip without being thrown into a page it didn't ask for */
function mkTap(ci,n){
 const fine=matchMedia('(hover:hover)').matches;
 if(fine||MKARMED===ci){ mkHide(); openArcAt(ci,n); return; }
 MKARMED=ci; mkPop(ci,true);
}
function openArcAt(ci,n){
 const rows=[...$('e-body').querySelectorAll('.arcrow')];
 const row=rows[ci]; if(!row)return;
 rows.forEach(r=>r.classList.remove('open'));
 row.classList.add('open');
 row.scrollIntoView({block:'center',behavior:'smooth'});
}

addEventListener('pointerdown',e=>{
 const t=e.target.closest?e.target:null;
 if(!t||!t.closest('.strip')) mkHide();
 if(!t||!t.closest('.shape')) shHide();
});
let LASTE=null;
function openE(name,focusN){
 LASTE=name;
 const ix=codexIndex();
 let e=ix[String(name).toLowerCase()];
 /* Somebody who joined tonight is in nobody's recording yet. They still get
    a page — an empty arc is not a missing character, it is a new one. */
 if(!e){ const r=pcOf(name); if(!r) return;
  e={name:r.name,kind:'pc',hits:[],aliases:new Set(),reveal:null,first:Infinity}; }
 const pc=pcOf(e.name), art=artOf(e.name), meta=metaOf(e.name);
 const q=JSON.stringify(e.name).replace(/"/g,'&quot;');

 const hero=$('e-hero');
 if(art.hero){ hero.style.backgroundImage=`url('${art.hero}')`; hero.classList.add('on'); }
 else { hero.style.backgroundImage=''; hero.classList.remove('on'); }
 document.body.classList.toggle('haspc',!!art.hero);

 const status=pc&&pc.status==='gone'?' · no longer with the party'
            :pc&&pc.status==='incoming'?' · joining soon':'';
 $('e-name').textContent=e.name;

 /* Anything about the person — their picture, the line under their name, the
    things they carry — is always open to whoever is holding the phone. Only
    the campaign's own record stays behind Edit. */
 const BUILD=(e.kind==='pc')||EDIT;
 const pen=f=>BUILD?` <button class="pen" onclick="editMeta(${q},'${f}')">edit</button>`:'';
 $('e-extra').innerHTML=
   (meta.sub||BUILD?`<div class="esub">${esc(meta.sub)||'<i class="dim">no subtitle yet</i>'}${pen('sub')}</div>`:'')
  +(meta.blurb||BUILD?`<div class="eblurb">${esc(meta.blurb)||'<i class="dim">no line written yet</i>'}${pen('blurb')}</div>`:'')
  +(art.gallery.length?`<div class="gal">${art.gallery.map(g=>
     `<div class="galimg" style="background-image:url('${g}')" onclick="lightbox('${g}')">
       ${BUILD?`<span class="galx" onclick="event.stopPropagation();rmArt(${q},'${g}')">×</span>`:''}</div>`).join('')}</div>`:'')
  +(BUILD?`<div class="bldbar">
      <span class="bldlab">Build them</span>
      <label class="up">${art.hero?'Change the picture':'Add a picture'}
        <input type="file" accept="image/*" onchange="upArt(${q},'hero',this)"></label>
      <label class="up">Add to the gallery
        <input type="file" accept="image/*" multiple onchange="upArt(${q},'gallery',this)"></label>
      <button class="up" onclick="editMeta(${q},'blurb')">Write their line</button>
      ${art.hero?`<button class="up danger" onclick="rmHero(${q})">Remove the picture</button>`:''}
    </div>`:'');

 const chapters=arcOf(e); STRIP=chapters; MKARMED=-1;
 $('e-kind').textContent=`${CAMPAIGN.kindLabels[e.kind]||e.kind}${status}`
   +(chapters.length?` · in ${chapters.length} session${chapters.length===1?'':'s'} · first in session ${chapters[0].s.n}`
                    :' · not in a recording yet');
 const arc=chapters.map((c,ci)=>`
  <div class="arcrow ${c.s.n===e.first?'lit':''}" onclick="arcToggle(this)">
   <div class="arcn">Session ${c.s.n} · ${esc(c.s.pretty)}${ci===0?' · first seen':''}</div>
   <div class="arcl">${esc(trim(c.head,160))}</div>
   <div class="arcmore">
    ${c.notes.filter(n=>n.txt!==c.head).map(n=>`<div class="li" onclick="event.stopPropagation();jump(${c.si},${n.t==null?'null':n.t})">
      <span class="tc ${n.t==null?'none':''}">${fmt(n.t)}</span><p>${esc(n.txt)}</p></div>`).join('')}
    ${c.moments.map(b=>`<div class="li" onclick="event.stopPropagation();jump(${c.si},${b.t==null?'null':b.t})">
      <span class="tc ${b.t==null?'none':''}">${fmt(b.t)}</span>
      <p><b style="font-weight:400">${esc(b.title)}</b> — ${esc(b.line)}</p></div>`).join('')}
   </div></div>`).join('');

 /* ── everything else, folded ── */
 const seen=new Set(); let said='';
 e.hits.forEach(({s,e:ent})=>{ const note=(ent.note||'').trim();
  if(!note||seen.has(note))return; seen.add(note);
  said+=`<div class="li" onclick="jump(${SESSIONS.indexOf(s)},${ent.t==null?'null':ent.t})">
   <span class="tc ${ent.t==null?'none':''}">${fmt(ent.t)}</span>
   <p>${esc(note)}<span class="src">Source · <b>Session ${s.n}</b> — ${esc(s.subtitle||s.title)}</span></p></div>`; });

 const al=[...e.aliases].filter(a=>a.toLowerCase()!==e.name.toLowerCase());
 let known='';
 if(meta.truename) known+=`<div class="kline"><span>True name</span>${esc(meta.truename)}</div>`;
 if(e.reveal)      known+=`<div class="kline"><span>Learned in play</span>${esc(e.reveal)}</div>`;
 if(pc&&pc.note)   known+=`<div class="kline"><span>Where they stand</span>${esc(pc.note)}</div>`;
 if(al.length)     known+=`<div class="kline"><span>Written in the notes as</span>${al.map(a=>esc(a)).join(' · ')}</div>`;
 if(EDIT)          known+=`<div class="kline"><span>True name</span><button class="pen" onclick="editMeta(${q},'truename')">${meta.truename?'change':'add one'}</button></div>`;

 const mus=musicFor(e.name);
 const music=(mus?`<div class="scmain">${musicBlock(mus,true)}</div>`:EDIT?'<div class="prevnone">No playlist linked yet.</div>':'')
  +(EDIT?`<div class="uploads"><button class="up" onclick="addMusic(${q})">${mus?'Change':'Add'} playlist</button></div>`:'');

 /* ── what they carry ── */
 const K=kitOf(e.name).filter(canSee);
 const kit=(K.length?`<div class="kit">${K.map(it=>{
   const iq=JSON.stringify(it.id).replace(/"/g,'&quot;');
   return `<div class="kitem ${it.vis==='mine'?'mine':''} ${EDIT&&!it.img?'noimg':''}">
    ${BUILD?`<div class="kedit">
      <button onclick="this.nextElementSibling.click()">${it.img?'Change':'Picture'}</button>
      <input type="file" accept="image/*" hidden onchange="upKit(${q},${iq},this)">
      <button onclick="editKit(${q},${iq})">Edit</button>
      <button onclick="rmKit(${q},${iq})">Remove</button></div>`:''}
    <div class="kimg ${it.img?'':'none'}" ${it.img?`style="background-image:url('${it.img}')" onclick="lightbox('${it.img}')"`:''}></div>
    <div class="kin">
     <div class="kt">${kitText(it.text)}</div>
     ${it.note?`<div class="kn">${esc(it.note)}</div>`:''}
     <div class="kbar"><span class="tagp">Not played yet</span>
      ${it.vis==='mine'?'<span class="tagm">Just yours</span>':''}
      ${it.who?`<span class="tagl">${esc(it.who)}</span>`:''}</div>
    </div></div>`;}).join('')}</div>`
  :BUILD?`<div class="kitnone">
      <b>Nothing here yet.</b>
      A weapon, a keepsake, a debt, a letter they have never opened. Each one can carry
      its own picture, and if you name something the campaign already knows, the vault
      joins them up on its own.</div>`:'')
 +(BUILD?`<div class="uploads"><button class="up" onclick="addKit(${q})">Add something they carry</button>
    <span class="uphint">Everything here can be edited, given a picture, or kept to yourself — nothing is final.</span></div>`:'');

 /* ── what they declare ── */
 const SY=sayOf(e.name);
 const anySay=SAYS.some(([f])=>SY[f]&&SY[f].v&&canSee(SY[f]));
 const said2=(anySay||BUILD)?`<div class="said">${SAYS.map(([f,label])=>{
   const o=SY[f]; const show=o&&o.v&&canSee(o);
   if(!show&&!BUILD) return '';
   return `<div class="sayrow"><div class="sq">${esc(label)}</div><div>
     <div class="sa ${show?'':'empty'}">${show?esc(o.v):'Not answered yet.'}</div>
     <div class="sbar">${show?'<span class="tagp">Not played yet</span>':''}
      ${show&&o.vis==='mine'?'<span class="tagm">Just yours</span>':''}
      ${BUILD?`<button class="pen" onclick="sayEdit(${q},'${f}')">${show?'change':'answer it'}</button>`:''}</div>
    </div></div>`;}).join('')}</div>`:'';

 $('e-body').innerHTML=
   stripFor(chapters)
  +esec('kit','What they carry',K.length||null,kit,BUILD)
