/* ═══════ PREVIOUSLY ON ═══════
   Assembled entirely from earlier sessions' own recorded data. Nothing here is
   written or inferred — every line is a quote from a prior session, with its
   source shown. Because it is computed at render time, adding a new session
   updates this automatically. There is no separate step to remember. */
function previously(i){
 const s=SESSIONS[i];
 const prior=SESSIONS.filter(x=>x.n<s.n).sort((a,b)=>b.n-a.n);
 if(!prior.length) return null;
 const last=prior[0];
 const changed=(last.cards||{}).changed;
 const said=(last.next||[]).slice(0,5);
 const open=[];
 prior.forEach(x=>(x.threads||[]).forEach(th=>{
   if(th.resolved) return;
   if(open.some(o=>o.q.toLowerCase()===th.q.toLowerCase())) return;
   open.push({...th,from:x});
 }));
 const rank={hi:0,md:1,lo:2};
 open.sort((a,b)=>(rank[a.u]??3)-(rank[b.u]??3)||b.from.n-a.from.n);
 const seenBefore=[];
 (s.entities||[]).forEach(e=>{
  const nm=String(e.name||'').toLowerCase(); if(!nm) return;
  let lastSeen=null;
  for(const x of prior){ if((x.entities||[]).some(y=>String(y.name||'').toLowerCase()===nm)){ lastSeen=x; break; } }
  if(lastSeen&&!seenBefore.some(v=>v.name.toLowerCase()===nm))
    seenBefore.push({name:e.name,kind:e.kind,at:lastSeen});
 });
 seenBefore.sort((a,b)=>b.at.n-a.at.n);
 return {last,changed,said,open:open.slice(0,6),seen:seenBefore.slice(0,10),priorCount:prior.length};
}
let PREVCOL=false;
function renderPreviously(i){
 const box=$('s-prev'); const P=previously(i);
 if(!P){ box.innerHTML=`<div class="prevnone">This is where the record begins. Nothing came before it.</div>`; return; }
 const L=P.last, li=SESSIONS.indexOf(L);
 const top=P.open[0];
 const ch=P.changed&&P.changed.headline?P.changed:null;

 /* Tier 1 — always visible. Roughly 25 words. If you read nothing else,
