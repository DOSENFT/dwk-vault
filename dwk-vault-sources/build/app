/* ═══════ EDITING ═══════ */
let EDIT=false; const CHANGES=[];
function ed(el,val,i,field){ el.textContent=val; el.setAttribute('data-e',i+'|'+field); }
function setPath(obj,path,val){
 const parts=path.split('.'); let o=obj;
 for(let k=0;k<parts.length-1;k++) o=o[parts[k]];
 o[parts[parts.length-1]]=val;
}
function getPath(obj,path){ return path.split('.').reduce((o,k)=>o==null?o:o[k],obj); }
document.addEventListener('focusout',e=>{
 const el=e.target.closest?.('[data-e]'); if(!el||!EDIT)return;
 const [i,path]=el.getAttribute('data-e').split('|');
 const s=SESSIONS[+i]; let val=el.textContent.trim();
 if(path==='party'){ const arr=val.split('·').map(x=>x.trim()).filter(Boolean);
   if(JSON.stringify(arr)!==JSON.stringify(s.party)) pushEdit('session_field',{slug:s.slug,path:'party',value:arr});
   return; }
 const cur=getPath(s,path);
 if(String(cur??'')!==val) pushEdit('session_field',{slug:s.slug,path,value:val});
});
function delItem(i,arr,idx){
 const s=SESSIONS[i]; const gone=s[arr][idx];
 if(!confirm('Delete this '+arr.replace(/s$/,'')+'?\n\n'+(gone.title||gone.q||gone.name||''))) return;
 CHANGES.push({session:s.slug,field:arr,deleted:(gone.title||gone.q||gone.name)});
 s[arr].splice(idx,1); markDirty(); openS(i);
}
