        </div>`).join('')}</div></div>`:''}
   ${P.seen.length?`<div class="pvsec"><h4>You have met these before</h4>
     <div class="prevseen">${P.seen.slice(0,8).map(v=>
       `<span class="prevface" onclick="openE(${JSON.stringify(v.name).replace(/"/g,'&quot;')})">${esc(v.name)}
         <em>S${v.at.n}</em></span>`).join('')}</div></div>`:''}
   ${L.recap?`<details class="prevrecap"><summary>The full recap of Session ${L.n}</summary><p>${esc(L.recap)}</p></details>`:''}
  </div>`;

 box.innerHTML=`<div class="prev">${tier1}${tier2}</div>`;
