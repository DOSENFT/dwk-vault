/* a seek asked for before the file knows its own length is remembered, not lost */
function seekTo(t){
 if(t==null)return;
 PENDING=t;
 if(au.readyState>=1){ try{ au.currentTime=t; PENDING=null; }catch(e){} }
}
let STARTWATCH=null;
/* Nothing looks more broken than a play button that goes quiet. A three-hour
   recording on a slow connection takes a moment to start, so say so — and if
   it really is stuck, hand over a page that can say why. */
function trouble(msg){
 const el=$('h-offline');
 if(el) el.innerHTML=`<div class="offline"><b>${esc(msg)}</b>
   <a class="offlink" href="check.html">Check this device &#8599;</a></div>`;
 const h=$('r-hint'); if(h) h.innerHTML=`<b>${esc(msg)}</b>`;
 note(msg,true);
}
function startPlay(){                    /* only ever from a real tap */
 document.body.classList.add('waiting');
 clearTimeout(STARTWATCH);
 STARTWATCH=setTimeout(()=>{
  if(au.paused||!au.currentTime) trouble('The recording will not start on this device.');
 },14000);
 note('Loading the recording…');
 const p=au.play();
 if(p&&p.catch) p.catch(err=>{
  const why=(err&&err.name)||'';
  note(LOCALFILE
   ? 'This is a downloaded copy — open the online vault to listen'
   : why==='NotAllowedError' ? 'Your browser wants a tap on the play button first'
   : 'That recording would not start — try again on wifi', true);
 });
}
function jump(i,t){
 CUR=i;
 if(LOADED!==i) load(i);
 const s=SESSIONS[i];
 if(AUDIO_URLS[s.slug]){ seekTo(t==null?0:t); startPlay(); }
 if(t!=null){ $('p-time').textContent=`${fmt(t)} / ${fmt(s.durationSec)}`;
  $('p-fill').style.width=(100*t/(s.durationSec||1))+'%'; syncReel(t); }
}
$('pb').onclick=()=>{ if(au.paused) startPlay(); else au.pause(); };
/* Pressing play anywhere means "take me listening", not "start a sound
   somewhere behind this wall of text". */
function listen(i,t){ jump(i,t); openReel(); }

function setPlayUI(on){
 $('pb').textContent=on?'❚❚':'▶';
 const rp=$('r-play'); if(rp) rp.textContent=on?'❚❚':'▶';
 document.body.classList.toggle('playing',on);
}
const settled=()=>{ clearTimeout(STARTWATCH); document.body.classList.remove('waiting'); };
['play','playing'].forEach(e=>au.addEventListener(e,()=>{ setPlayUI(true);
 if(e==='playing'){ settled(); note('Playing'); if(typeof rescueNote==='function') rescueNote(); } }));
['pause','ended'].forEach(e=>au.addEventListener(e,()=>{ setPlayUI(false); settled(); }));
/* If this ever fails on someone's phone, it says WHY, in words they can read
   back to me. A silent play button cost us an evening once. */
au.addEventListener('error',()=>{
 setPlayUI(false); settled();
 if(!au.getAttribute('src'))return;
 const c=(au.error&&au.error.code)||0;
 note(LOCALFILE
  ? 'A saved copy cannot fetch the recordings — open the live vault'
  : ({1:'Playback was cancelled — tap play again',
      2:'Lost the connection — try again on wifi',
      3:'That part of the recording would not decode',
      4:'This browser refused the recording (code 4)'}[c]
     ||'The recording would not load (code '+c+')')
 ,true);
 if(!LOCALFILE) trouble(({2:'Lost the connection to the recording.',
   3:'That recording would not decode.',
   4:'This browser refused the recording.'}[c])||'The recording would not load.');
});
au.addEventListener('loadedmetadata',()=>{
 if(PENDING!=null){ try{ au.currentTime=PENDING; }catch(e){} PENDING=null; }
 $('p-sub').style.color=''; note('Tap any timecode to jump');
 const e=$('r-end'); if(e) e.textContent=fmt(SESSIONS[CUR]&&SESSIONS[CUR].durationSec);
});
au.addEventListener('waiting',()=>note('Buffering…'));
au.addEventListener('timeupdate',()=>{
 const s=SESSIONS[CUR]; if(!s)return;
 const d=s.durationSec||au.duration||1;
 $('p-time').textContent=`${fmt(au.currentTime)} / ${fmt(s.durationSec)}`;
 $('p-fill').style.width=(100*au.currentTime/d)+'%';
 const f=$('r-fill'); if(f) f.style.width=(100*au.currentTime/d)+'%';
 const n=$('r-now'); if(n) n.textContent=fmt(au.currentTime);
 if(REELON) syncReel(au.currentTime,true);
 remember();
});
const scrub=(el,e)=>{ const r=el.getBoundingClientRect();
 const x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;
 jump(CUR,Math.round(Math.max(0,Math.min(1,x/r.width))*(SESSIONS[CUR].durationSec||0))); };
$('p-trk').onclick=e=>scrub(e.currentTarget,e);
$('r-trk').onclick=e=>scrub(e.currentTarget,e);

/* ═══════ THE REEL ═══════
   A vertical reel of the night. You thumb through it; the room changes
   colour under you and the recording follows. It follows you back, too —
   leave it alone while something is playing and it scrolls itself. */
let RB=[], RI=0, REELON=false, RTOUCH=0, RSETTLE=null, RAUTO=false;
function buildReel(i){
 const s=SESSIONS[i]; RB=s.beats; RI=0;
 $('r-sess').innerHTML=`Session <b>${s.n}</b> · ${esc(s.subtitle||s.title)}`;
 $('r-end').textContent=fmt(s.durationSec);
 const useT=s.hasTimecodes&&s.durationSec&&s.timecodesReliable!==false;

 $('r-scroll').innerHTML='<div class="rpad"></div>'+RB.map((b,k)=>{
  const h=HUE[b.kind]||'#9a9086';
  return `<article class="rcard" data-k="${k}">
   <div class="rkind" style="color:${h}"><i></i>${LABEL[b.kind]||b.kind}${b.t!=null?' · '+fmt(b.t):' · no timecode'}</div>
   <h2>${esc(b.title)}</h2>
   <p class="rline">${esc(b.line)}</p>
   <div class="rfacets">${(b.facets||[]).map(f=>`<span class="rfacet"><b>${esc(f[0])}</b>${esc(f[1])}</span>`).join('')}</div>
  </article>`; }).join('')+'<div class="rpad"></div>';

 const rail=$('r-rail'); rail.innerHTML='';
 RB.forEach((b,k)=>{
  const n=document.createElement('button'); n.className='notch';
  n.style.left=(useT&&b.t!=null? (b.t/s.durationSec*100) : (k/(RB.length-1||1)*100))+'%';
  /* how much was recorded at that moment, as height */
  const weight=Math.min(5,(b.facets||[]).length)+(b.kind==='boss'||b.kind==='reveal'?1.5:0);
  n.style.setProperty('--h',(6+weight*2.2).toFixed(1)+'px');
  n.innerHTML='<i></i>'; n.setAttribute('aria-label','Moment '+(k+1)+(b.t!=null?' at '+fmt(b.t):''));
  n.onclick=()=>{ scrollToBeat(k); paintBeat(k); hearBeat(k); };
  rail.appendChild(n);
 });
 paintBeat(0);
}
function paintBeat(k){
 if(!RB.length)return;
 RI=(k+RB.length)%RB.length;
 const b=RB[RI], m=MOOD[b.kind]||MOOD.scene;
 $('r-field').style.background=`radial-gradient(120% 90% at 22% 28%, ${m[1]} 0%, ${m[0]} 46%, #12100e 100%)`;
 $('r-scroll').querySelectorAll('.rcard').forEach(c=>c.classList.toggle('on',+c.dataset.k===RI));
 $('r-rail').querySelectorAll('.notch').forEach((n,x)=>{
  n.classList.toggle('on',x===RI); n.classList.toggle('past',x<RI); });
 $('r-pos').textContent=`Moment ${RI+1} of ${RB.length}`;
 if(typeof mediaMeta==='function') mediaMeta();
 if(!au.paused) return;
 $('r-now').textContent=b.t!=null?fmt(b.t):'no timecode';
}
function scrollToBeat(k,instant){
 const el=$('r-scroll').querySelector(`.rcard[data-k="${k}"]`); if(!el)return;
 RAUTO=true;
 el.scrollIntoView({block:'center',behavior:instant?'auto':'smooth'});
 setTimeout(()=>{RAUTO=false;},700);
}
function hearBeat(k){
 const b=RB[k]; if(!b||b.t==null)return;
 if(!AUDIO_URLS[SESSIONS[CUR].slug])return;
 seekTo(b.t); if(au.paused) startPlay();
}
/* which card is sitting in the middle of the screen */
function centred(){
 const sc=$('r-scroll'), r=sc.getBoundingClientRect(), mid=r.top+r.height/2;
 let best=RI, dist=1e9;
 sc.querySelectorAll('.rcard').forEach(c=>{
  const b=c.getBoundingClientRect(), d=Math.abs(b.top+b.height/2-mid);
  if(d<dist){ dist=d; best=+c.dataset.k; }
 });
 return best;
}
$('r-scroll').addEventListener('scroll',()=>{
 if(RAUTO)return;
 RTOUCH=Date.now();
 const k=centred(); if(k!==RI) paintBeat(k);
 clearTimeout(RSETTLE);
 RSETTLE=setTimeout(()=>{
  /* thumbing while it plays moves the recording with you; thumbing while it
     is stopped just looks around, and play starts from wherever you stopped */
  if(!au.paused) hearBeat(centred());
 },220);
},{passive:true});

function syncReel(t,soft){
 const s=SESSIONS[CUR]; if(!RB.length||!s.hasTimecodes||s.timecodesReliable===false)return;
 let best=-1; RB.forEach((b,x)=>{ if(b.t!=null&&b.t<=t+0.5) best=x; });
 if(best<0||best===RI)return;
 paintBeat(best);
 if(REELON&&soft&&Date.now()-RTOUCH>2500) scrollToBeat(best);
}
function openReel(){
 $('reel').classList.add('on'); REELON=true;
 document.body.style.overflow='hidden';
 scrollToBeat(RI,true);
 $('r-hint').textContent=AUDIO_URLS[SESSIONS[CUR].slug]
  ? 'Scroll the moments · it follows the recording' : 'No recording for this session';
 try{ history.pushState({reel:1},''); }catch(e){}
}
function closeReel(){
 $('reel').classList.remove('on'); REELON=false;
 document.body.style.overflow='';
}
$('p-exp').onclick=openReel;
$('r-close').onclick=()=>{ if(history.state&&history.state.reel) history.back(); else closeReel(); };
addEventListener('popstate',()=>{ if(REELON) closeReel(); });
$('r-play').onclick=()=>{
 if(au.paused){ const b=RB[RI];
  if(b&&b.t!=null&&Math.abs(au.currentTime-b.t)>2) seekTo(b.t);
  startPlay();
 } else au.pause();
};
$('r-prev').onclick=()=>{ const k=(RI-1+RB.length)%RB.length; scrollToBeat(k); paintBeat(k); hearBeat(k); };
$('r-next').onclick=()=>{ const k=(RI+1)%RB.length; scrollToBeat(k); paintBeat(k); hearBeat(k); };
$('r-back').onclick=()=>{ seekTo(Math.max(0,au.currentTime-15)); };
$('r-fwd').onclick =()=>{ seekTo(au.currentTime+15); };
addEventListener('keydown',e=>{
 if(document.activeElement===$('srch'))return;
 if(!REELON)return;
 if(e.key==='ArrowDown'||e.key==='ArrowRight'){ e.preventDefault(); $('r-next').onclick(); }
 if(e.key==='ArrowUp'  ||e.key==='ArrowLeft' ){ e.preventDefault(); $('r-prev').onclick(); }
 if(e.key===' '){ e.preventDefault(); $('r-play').onclick(); }
 if(e.key==='Escape') $('r-close').onclick();
});

/* ═══════ LISTENING IS THE POINT ═══════
