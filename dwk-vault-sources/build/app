/* ═══════ WHAT THEY DECLARE ═══════
   Three questions, asked once, in the character's own voice. They are marked
   as not-yet-played until the night they actually come up at the table. */
async function sayEdit(name,field){
 const cur=sayOf(name)[field]||{};
 const ix=codexIndex();
 const known=k=>Object.values(ix).filter(e=>e.kind===k)
   .sort((a,b)=>b.hits.length-a.hits.length).slice(0,10).map(e=>e.name);
 const ask={from:['Where are they from?',
    'The world already has five nations in it. Start from one, or name a town, a house or a road nobody in the campaign has heard of — that works too.',
    (CAMPAIGN.nations||[]).slice(),
