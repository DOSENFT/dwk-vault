/* ═══════ PLAYER ═══════ */
/* ═══════ THE RECORDING ═══════
   Two hard rules learned the hard way on a phone:
   1. play() is called synchronously inside the tap that asked for it. Any
      await, any callback, and iOS treats it as autoplay and refuses.
   2. The button never lies. Its face is driven by what the audio element
      actually did, never by what we hoped it would do. A play button that
      says "playing" while silence comes out is worse than no button. */
const au=$('au'); let LOADED=-1, PENDING=null;
au.setAttribute('playsinline','');
au.preload='metadata';
const LOCALFILE=location.protocol==='file:';

let LAST=null;
try{ LAST=JSON.parse(localStorage.getItem('dwk-last')||'null'); }catch(e){}
let lastWrote=0;
function remember(){
 const s=SESSIONS[CUR]; if(!s||!au.currentTime||au.currentTime<5)return;
 const now=Date.now(); if(now-lastWrote<4000)return; lastWrote=now;
 LAST={slug:s.slug,t:Math.floor(au.currentTime)};
 try{ localStorage.setItem('dwk-last',JSON.stringify(LAST)); }catch(e){}
}
const resumeFor=s=>(LAST&&LAST.slug===s.slug&&LAST.t>30)?LAST.t:0;

function note(msg,warn){
 $('p-sub').textContent=msg;
 $('p-sub').style.color=warn?'var(--gold)':'';
 const h=$('r-hint'); if(h) h.innerHTML=warn?`<b>${esc(msg)}</b>`:esc(msg);
}
function load(i){
