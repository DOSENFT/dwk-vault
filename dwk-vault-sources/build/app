/* ═══════ FIND & REPLACE ═══════
   Walks every piece of writing in the vault and swaps one spelling for another.
   Counts first, changes second. */
const TEXT_PATHS=[
 ['title'],['subtitle'],['logline'],['recap'],['opens'],['closes'],
 ['cards','changed','headline'],['cards','changed','detail'],
 ['cards','learned','headline'],['cards','learned','detail'],
 ['cards','who','headline'],['cards','who','detail'],
 ['cards','cost','headline'],['cards','cost','detail'],
 ['cards','hanging','headline'],['cards','hanging','detail']
];
function walkText(s,fn){
 TEXT_PATHS.forEach(pth=>{
  let o=s; for(let k=0;k<pth.length-1;k++){ o=o&&o[pth[k]]; }
  const key=pth[pth.length-1];
  if(o&&typeof o[key]==='string') o[key]=fn(o[key]);
 });
 (s.beats||[]).forEach(b=>{
  if(typeof b.title==='string') b.title=fn(b.title);
  if(typeof b.line==='string')  b.line=fn(b.line);
  (b.facets||[]).forEach(f=>{ if(typeof f[1]==='string') f[1]=fn(f[1]);
                              if(typeof f[0]==='string') f[0]=fn(f[0]); });
 });
 (s.threads||[]).forEach(x=>{ if(typeof x.q==='string') x.q=fn(x.q); });
 (s.entities||[]).forEach(e=>{ if(typeof e.name==='string') e.name=fn(e.name);
                               if(typeof e.note==='string') e.note=fn(e.note); });
 s.next=(s.next||[]).map(n=>typeof n==='string'?fn(n):n);
 s.party=(s.party||[]).map(n=>typeof n==='string'?fn(n):n);
 s.gaps=(s.gaps||[]).map(n=>typeof n==='string'?fn(n):n);
}
const rxEsc=v=>v.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
function frCount(find,matchCase){
 if(!find) return {hits:0,sessions:0,samples:[]};
 let hits=0,sessions=0; const samples=[];
 SESSIONS.forEach(s=>{
  let n=0;
  walkText(s,txt=>{
    const rx=new RegExp(rxEsc(find),matchCase?'g':'gi');
    const m=txt.match(rx);
    if(m){ n+=m.length;
      if(samples.length<4){ const i=txt.search(new RegExp(rxEsc(find),matchCase?'':'i'));
        samples.push('…'+txt.slice(Math.max(0,i-32),i+find.length+32).trim()+'…'); } }
    return txt; });
  if(n){ hits+=n; sessions++; }
 });
 return {hits,sessions,samples};
}
function doReplace(find,repl,matchCase){
 let n=0;
 const sub=txt=>txt.replace(new RegExp(rxEsc(find),matchCase?'g':'gi'),()=>{n++;return repl;});
 SESSIONS.forEach(s=>walkText(s,sub));
 ['kinds','renames','merges'].forEach(k=>{
  if(!CODEX[k]||Array.isArray(CODEX[k]))return;
  const out={}; Object.entries(CODEX[k]).forEach(([kk,vv])=>{
   out[kk.replace(new RegExp(rxEsc(find),'gi'),repl).toLowerCase()]=
     typeof vv==='string'?vv.replace(new RegExp(rxEsc(find),matchCase?'g':'gi'),repl):vv; });
  CODEX[k]=out;
 });
 CAMPAIGN.roster.forEach(r=>{
  if(r.name) r.name=r.name.replace(new RegExp(rxEsc(find),matchCase?'g':'gi'),repl);
  if(r.realName) r.realName=r.realName.replace(new RegExp(rxEsc(find),matchCase?'g':'gi'),repl); });
 (CAMPAIGN.music||[]).forEach(m=>{ m.subject=m.subject.replace(new RegExp(rxEsc(find),matchCase?'g':'gi'),repl); });
 ['meta','art'].forEach(k=>{ if(!CODEX[k])return; const out={};
  Object.entries(CODEX[k]).forEach(([kk,vv])=>{
   out[kk.replace(new RegExp(rxEsc(find),'gi'),repl).toLowerCase()]=vv; });
  CODEX[k]=out; });
 return n;
}
function frApply(find,repl,matchCase){
 const n=frCount(find,matchCase).hits;
 pushEdit('replace',{find,repl,matchCase});
 return n;
}
