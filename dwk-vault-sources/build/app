/* ═══════ A CHARACTER, AS AN ARC ═══════
   The old page was a wall: every note, every moment, all at once. Nobody read
   it. This is the same material told as a life — one line per session, in the
   order it happened, and you open the night you care about. Everything else is
   folded away until asked for. Works the same for a player character, a
   villain, or a tavern nobody has thought about since session four. */
function esec(id,title,count,body,open,tag){
 if(!body) return '';
 return `<details class="esec" ${open?'open':''}><summary>
   <span class="caret">▾</span><h2>${esc(title)}</h2>${tag||''}
   ${count!=null?`<span class="c">${count}</span>`:''}</summary>
   <div class="esecb">${body}</div></details>`;
}
function arcToggle(el){ el.classList.toggle('open'); }
/* cut at a word, never mid-syllable — a truncated line still has to read */
function trim(t,n){ t=String(t||'').trim(); if(t.length<=n) return t;
 const cut=t.slice(0,n); const sp=cut.lastIndexOf(' ');
 return (sp>n*0.6?cut.slice(0,sp):cut).replace(/[\s,;:—-]+$/,'')+'…'; }
/* ═══════ WHERE THEY STAND ═══════
   Everything in here is read out of the sixteen recordings. Nobody chose any
   of it and nobody can argue with it — the vault is only reporting who the
   record put in the same breath as who. This is the half of a character page
   that is fact; the kit and the declared lines are the half that isn't, and
   the two are never allowed to look alike.

   The work is done once, the first time anybody opens a character page, and
   then held. It costs about fifteen milliseconds. */
let TIES=null;
function tieIndex(){
 if(TIES&&TIES.n===SESSIONS.length&&TIES.stamp===CHANGES.length) return TIES;
 const ix=codexIndex(), ents=Object.values(ix);
 const RX=t=>String(t).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');

 /* "Rune" and "Rune Willow" are one person written two ways, and the pair
    count would otherwise say she is closest to herself. Fold a short entry
    into a longer one of the same kind that simply continues it — but never
    across a possessive, because Dion and Dion's Priest are two people. */
 const fold={};
 ents.forEach(a=>ents.forEach(b=>{
  if(a===b||a.name.length>=b.name.length||a.kind!==b.kind) return;
  if(new RegExp('^'+RX(a.name)+"(?![\\w'’])\\b",'i').test(b.name)) fold[a.name.toLowerCase()]=b.name.toLowerCase();
 }));
 const K=k=>fold[k]||k;

 const alias=[];
 ents.forEach(e=>{ const k=e.name.toLowerCase();
  [e.name,...e.aliases].forEach(a=>{ a=String(a||'').trim(); if(a.length>=3) alias.push([a,K(k)]); }); });
 const shortA=alias.filter(a=>a[0].length<6), longA=alias.filter(a=>a[0].length>=6);
 /* a short name has to be capitalised the way the record capitalises it,
    or every "scar" in every sentence becomes a sighting of Scar */
 const rxS=shortA.length?new RegExp('\\b('+shortA.map(a=>RX(a[0])).join('|')+')\\b','g'):null;
 const rxL=longA.length?new RegExp('\\b('+longA.map(a=>RX(a[0])).join('|')+')\\b','gi'):null;
 const mapS=new Map(shortA.map(a=>[a[0],a[1]])), mapL=new Map(longA.map(a=>[a[0].toLowerCase(),a[1]]));
 function cast(txt){
  txt=String(txt||''); if(!txt) return [];
  const hits=[]; let m;
  if(rxS){ rxS.lastIndex=0; while((m=rxS.exec(txt))) hits.push([m.index,m.index+m[1].length,mapS.get(m[1])]); }
  if(rxL){ rxL.lastIndex=0; while((m=rxL.exec(txt))) hits.push([m.index,m.index+m[1].length,mapL.get(m[1].toLowerCase())]); }
  hits.sort((a,b)=>(b[1]-b[0])-(a[1]-a[0]));          /* longest name wins the ground */
  const taken=[], out=new Set();
  hits.forEach(h=>{ if(taken.some(t=>h[0]<t[1]&&h[1]>t[0])) return; taken.push(h); out.add(h[2]); });
  return [...out];
 }

 const P=new Map();
 const SEP=String.fromCharCode(1);
 const pair=(a,b)=>[a,b].sort().join(SEP);
 /* keep both ends of every bond: the first handful of times the record put
    two names together, and the last handful. The middle is not evidence. */
 const rec=(k,ev)=>{ const r=P.get(k)||{n:0,by:{},ev:[],tail:[]};
  if(r.ev.length<6) r.ev.push(ev);
  r.tail.push(ev); if(r.tail.length>6) r.tail.shift();
  return r; };
 SESSIONS.slice().sort((a,b)=>a.n-b.n).forEach(s=>{
  const si=SESSIONS.indexOf(s);
  (s.beats||[]).forEach(b=>{
   const c=cast([b.title,b.line,...(b.facets||[]).map(f=>f.join(' '))].join(' · '));
   for(let i=0;i<c.length;i++)for(let j=i+1;j<c.length;j++){
    const k=pair(c[i],c[j]);
    const r=rec(k,{sn:s.n,si,t:b.t,head:b.title,line:b.line});
    r.n++; r.by[s.n]=(r.by[s.n]||0)+1;
    P.set(k,r);
   }
  });
  /* the record's own summary of a night names people too, and those lines
     are the best evidence there is - they say what was actually done */
  (s.entities||[]).forEach(e=>{
   const me=K(String(e.name||'').toLowerCase()); if(!me) return;
   cast(e.note).forEach(o=>{ if(o===me) return;
    const k=pair(me,o);
    const r=rec(k,{sn:s.n,si,t:e.t,head:'What the record says of '+(ix[me]?ix[me].name:e.name),line:e.note});
    r.n++; r.by[s.n]=(r.by[s.n]||0)+1;
    P.set(k,r); });
  });
 });

 /* which of the open questions have this name in them */
 const Q=new Map();
 SESSIONS.forEach(s=>{ const si=SESSIONS.indexOf(s);
  (s.threads||[]).forEach((t,ti)=>cast(t.q).forEach(k=>{
   const a=Q.get(k)||[];
   a.push({si,ti,slug:s.slug,sn:s.n,t:t.t,q:t.q,u:t.u,
           resolved:!!t.resolved,hidden:!!t.hidden});
   Q.set(k,a); })); });

 const first=SESSIONS.reduce((a,s)=>Math.min(a,s.n),1e9);
 const last =SESSIONS.reduce((a,s)=>Math.max(a,s.n),0);
 TIES={n:SESSIONS.length,stamp:CHANGES.length,ix,fold,K,cast,P,Q,first,last,
       nights:SESSIONS.map(s=>s.n).sort((a,b)=>a-b)};
 return TIES;
}

/* ── the reading ────────────────────────────────────────────────────────
   One true sentence about where somebody stands, chosen by which true thing
   is the most worth saying. Every one of these is checked against the record
   before it is written, and if none of them holds, nothing is claimed. */


/* everything the record has to say about where one name stands */
function standingOf(name){
 const T=tieIndex(), me=T.K(String(name).toLowerCase());
 const hidden=new Set((CODEX.tiehide||{})[me]||[]);
 const bonds=[];
 T.P.forEach((v,k)=>{ const parts=k.split(String.fromCharCode(1)); if(parts[0]!==me&&parts[1]!==me) return;
  const other=parts[0]===me?parts[1]:parts[0]; if(other===me) return;
  const e=T.ix[other]; if(!e) return;
  const ns=Object.keys(v.by).map(Number).sort((x,y)=>x-y);
  bonds.push({key:other,name:e.name,kind:e.kind,n:v.n,by:v.by,nights:ns,
              first:ns[0],last:ns[ns.length-1],ev:v.ev,tail:v.tail,hidden:hidden.has(other)});
 });
 bonds.sort((a,b)=>b.n-a.n||a.name.localeCompare(b.name));
 const own=((CODEX.tieadd||{})[me]||[]).slice();
 return {me,name:(T.ix[me]||{}).name||name,bonds,own,
         threads:(T.Q.get(me)||[]).slice(),T};
}

/* ── drawing it ─────────────────────────────────────────────────────────
   A bond is a shape, not a number. Sixteen ticks, one per night, as tall as
   that night was busy between the two of them — so a friendship that grew,
   a friendship that stopped, and a friendship that was only ever one evening
   all look like themselves at a glance, before a word is read. */
const KTAG={pc:'',npc:'person',creature:'creature',faction:'faction',nation:'nation',
 place:'place',item:'thing',deity:'god',asterum:'asterum'};

/* No counts, no ranking, no shapes. How often two names land in the same
   paragraph is not a measure of how close two people are, and the moment a
   number like that is printed on a page somebody reads it as one. What is
   true, and what is useful, is only this: here is somebody they shared a
   scene with, and here are the lines from the night it happened. */
function sceneList(name){
 const st=standingOf(name);
 return st.bonds.filter(b=>!b.hidden&&b.n>=2)
   .sort((a,b)=>b.last-a.last||a.name.localeCompare(b.name));
}
function standRows(list,name){
 const q=JSON.stringify(name).replace(/"/g,'&quot;');
 return list.map(b=>{
  const seen=new Set(), pick=[];
  [...b.ev.slice(0,2),...(b.tail||[]).slice(-2)].forEach(e=>{
   const k=e.sn+'|'+e.t+'|'+e.head; if(seen.has(k)) return; seen.add(k); pick.push(e); });
  const rec=pick.map(e=>`<div class="li" onclick="event.stopPropagation();jump(${e.si},${e.t==null?'null':e.t})">
     <span class="tc ${e.t==null?'none':''}">${fmt(e.t)}</span>
     <p><b style="font-weight:400">${esc(e.head)}</b> — ${esc(trim(e.line,190))}
      <span class="src">Session <b>${e.sn}</b></span></p></div>`).join('');
  return `<div class="bond ${b.kind==='pc'?'kin':''}" onclick="bondTap(this)"
      role="button" tabindex="0" onkeydown="if(event.key==='Enter')bondTap(this)">
   <div class="bname">${esc(b.name)}${KTAG[b.kind]?`<em>${KTAG[b.kind]}</em>`:''}</div>
   <div class="bnum">${b.first===b.last?`Session ${b.last}`:`Sessions ${b.first}–${b.last}`}</div>
   <div class="bcar" aria-hidden="true">▾</div>
   <div class="brec">${rec}
     <div class="bfoot">
       <button class="pen" onclick="event.stopPropagation();openE(${JSON.stringify(b.name).replace(/"/g,'&quot;')})">Open ${esc(b.name)}</button>
       ${EDIT?`<button class="pen warn" onclick="event.stopPropagation();hideTie(${q},${JSON.stringify(b.key).replace(/"/g,'&quot;')})">Not really, take it off</button>`:''}
     </div></div></div>`;
 }).join('');
}
/* ten at a time, because seventy-six at a time is a wall */
function moreBonds(name){
 const host=$('b-more'), btn=$('b-morebtn'); if(!host||!btn) return;
 const vis=sceneList(name);
 const at=+host.dataset.i||8, next=Math.min(vis.length,at+10);
 host.insertAdjacentHTML('beforeend', standRows(vis.slice(at,next),name));
 host.dataset.i=next;
 if(next>=vis.length) btn.remove();
 else btn.innerHTML=`Show ten more <em>${vis.length-next} left</em>`;
}

/* ── the web ────────────────────────────────────────────────────────────
   Six names, drawn. Not ninety-one in a list, not a number beside anybody,
   and nothing arranged so that one of them looks like a winner: the ring is
   even, the lines are the same weight, and the only claim it makes is the one
   it states out loud — these are the names that come up alongside them most
   often in the recordings. Tap one and the actual lines from those nights
   appear underneath, each a timecode into the audio. Two taps to hearing it. */
let WEBSEL={};
function webPick(name,key){ WEBSEL[String(name).toLowerCase()]=key;
 const host=$('web-'+slugify(name)); if(host) host.outerHTML=webBlock(standingOf(name)); }

function nodeArt(nm){ const a=(CODEX.art||{})[String(nm).toLowerCase()]; return a&&a.hero||null; }

function webBlock(st){
 const T=st.T;
 const six=st.bonds.filter(b=>!b.hidden&&b.n>=2).sort((a,b)=>b.n-a.n).slice(0,6);
 if(six.length<3) return '';
 const me=st.me, sel=WEBSEL[me]&&six.some(b=>b.key===WEBSEL[me])?WEBSEL[me]:six[0].key;
 const cur=six.find(b=>b.key===sel);
 const W=360,H=352,cx=180,cy=166,R=118,r=25;
 const pt=i=>{ const a=(-90+i*(360/six.length))*Math.PI/180;
  return [cx+R*Math.cos(a), cy+R*Math.sin(a)]; };
 const clipDefs=[];
 const disc=(nm,x,y,rad,i,on)=>{
  const art=nodeArt(nm), id='wc'+i;
  if(art) clipDefs.push(`<clipPath id="${id}"><circle cx="${x}" cy="${y}" r="${rad}"/></clipPath>`);
  return (art?`<image href="${art}" x="${x-rad}" y="${y-rad}" width="${rad*2}" height="${rad*2}"
      preserveAspectRatio="xMidYMid slice" clip-path="url(#${id})" opacity="${on?1:.62}"/>`
    :`<text x="${x}" y="${y+rad*.34}" text-anchor="middle" class="wini" font-size="${rad*.95}">${esc(nm[0])}</text>`)
   +`<circle cx="${x}" cy="${y}" r="${rad}" class="wring ${on?'on':''}"/>`;
 };
 let lines='',nodes='',labels='';
 six.forEach((b,i)=>{
  const [x,y]=pt(i), on=b.key===sel;
  const dx=x-cx, dy=y-cy, L=Math.hypot(dx,dy);
  lines+=`<line x1="${(cx+dx/L*44).toFixed(1)}" y1="${(cy+dy/L*44).toFixed(1)}"
    x2="${(x-dx/L*(r+2)).toFixed(1)}" y2="${(y-dy/L*(r+2)).toFixed(1)}" class="wline ${on?'on':''}"/>`;
  nodes+=`<g class="wnode ${on?'on':''} ${b.kind==='pc'?'kin':''}" tabindex="0" role="button"
     onclick="webPick(${JSON.stringify(st.name).replace(/"/g,'&quot;')},${JSON.stringify(b.key).replace(/"/g,'&quot;')})"
     onkeydown="if(event.key==='Enter')this.onclick()">
    <circle cx="${x}" cy="${y}" r="${r+11}" fill="transparent"/>
    ${disc(b.name,x,y,r,i,on)}</g>`;
  labels+=`<text x="${x}" y="${y+r+19}" text-anchor="middle" class="wlab ${on?'on':''}">${esc(trim(b.name,15))}</text>`;
 });
 const pick=(()=>{ const seen=new Set(), out=[];
  [...cur.ev.slice(0,2),...(cur.tail||[]).slice(-2)].forEach(e=>{
   const k=e.sn+'|'+e.t+'|'+e.head; if(seen.has(k))return; seen.add(k); out.push(e); });
  return out; })();

 return `<div class="web" id="web-${slugify(st.name)}">
  <svg viewBox="0 0 ${W} ${H}" class="websvg" role="img"
     aria-label="The names the recordings put alongside ${esc(st.name)} most often">
   <defs>${clipDefs.join('')}</defs>
   ${lines}
   <g class="wme">${disc(st.name,cx,cy,40,'me',false)}</g>
   <text x="${cx}" y="${cy+40+19}" text-anchor="middle" class="wlab me">${esc(trim(st.name,16))}</text>
   ${nodes}${labels}
  </svg>
  <p class="webnote">The names that come up alongside them most in the recordings. Tap one.</p>
  <div class="webpanel">
   <div class="webhead"><b>${esc(st.name)}</b> and <b>${esc(cur.name)}</b>
     <span>${cur.first===cur.last?`Session ${cur.last}`:`Sessions ${cur.first}–${cur.last}`}</span></div>
   ${pick.map(e=>`<div class="li" onclick="jump(${e.si},${e.t==null?'null':e.t})">
     <span class="tc ${e.t==null?'none':''}">${fmt(e.t)}</span>
     <p><b style="font-weight:400">${esc(e.head)}</b> — ${esc(trim(e.line,180))}
      <span class="src">Session <b>${e.sn}</b></span></p></div>`).join('')}
   <div class="bfoot"><button class="pen" onclick="openE(${JSON.stringify(cur.name).replace(/"/g,'&quot;')})">Open ${esc(cur.name)}</button></div>
  </div></div>`;
}

function standBlock(st){
 const q=JSON.stringify(st.name).replace(/"/g,'&quot;');
 const vis=sceneList(st.name);
 const hid=st.bonds.filter(b=>b.hidden);
 const qs=st.threads.filter(t=>!t.hidden)
   .sort((a,b)=>(a.resolved?1:0)-(b.resolved?1:0)||b.sn-a.sn);
 if(!vis.length&&!qs.length&&!st.own.length&&!hid.length)
  return `<div class="prevnone">The record has not met them yet. The first night they play,
    everyone they share a scene with starts appearing here on its own.</div>`;

 return webBlock(st)
  +(vis.length?`<div class="bhead">Everyone else <span class="c">${vis.length}</span></div>
    <p class="standnote">Everyone the recordings put in a scene with them, the most recent first.
     Open one to hear the night it happened.</p>
    <div class="bonds">${standRows(vis.slice(0,8),st.name)}</div>
    ${vis.length>8?`<div class="bonds" id="b-more" data-i="8"></div>
      <button class="up wide" id="b-morebtn" onclick="moreBonds(${q})">Show ten more <em>${vis.length-8} left</em></button>`:''}`:'')
  +(qs.length?`<div class="bhead">Questions the record left open about them <span class="c">${qs.length}</span></div>
     <div class="qs">${qs.slice(0,4).map(qrow).join('')}</div>
     ${qs.length>4?`<div class="qs hidden" id="q-more">${qs.slice(4).map(qrow).join('')}</div>
       <button class="up wide" onclick="this.previousElementSibling.classList.remove('hidden');this.remove()">
         Show the other ${qs.length-4}</button>`:''}`:'')
  +(st.own.filter(canSee).length?`<div class="bhead">Added by the table</div>
     <div class="bonds">${st.own.filter(canSee).map(o=>`<div class="bond said2">
       <div class="bname">${esc(o.name)}</div>
       <div class="bnum">${esc(o.how||'')}</div>
       <div class="btags"><span class="tagp">Not played yet</span>${o.vis==='mine'?'<span class="tagm">Just yours</span>':''}
         ${EDIT?`<button class="pen warn" onclick="rmTie(${q},'${o.id}')">Remove</button>`:''}</div>
      </div>`).join('')}</div>`:'')
  +(hid.length&&EDIT?`<div class="bhead">Taken off <span class="c">${hid.length}</span></div>
      <div class="bonds">${hid.map(b=>`<div class="bond off"><div class="bname">${esc(b.name)}</div>
        <div class="bnum"><button class="pen" onclick="unhideTie(${q},${JSON.stringify(b.key).replace(/"/g,'&quot;')})">Put it back</button></div></div>`).join('')}</div>`:'')
  +(EDIT?`<div class="uploads"><button class="up" onclick="addTie(${q})">The record missed someone</button>
      <span class="uphint">Anything added by hand is marked as not having happened yet — it never gets dressed up as something the recordings said.</span></div>`:'');
}
/* A tie the record found but the table knows is wrong is a correction, not an
   argument: it stops being shown, and the recording it came from is not
   touched. Anyone can put it back, and nothing in the log is ever removed to
   do either. */
function hideTie(name,key){ pushEdit('pc_tie',{op:'hide',name,key,who:whoAmI()}); openE(name); }
function unhideTie(name,key){ pushEdit('pc_tie',{op:'unhide',name,key,who:whoAmI()}); openE(name); }
function rmTie(name,id){ pushEdit('pc_tie',{op:'rm',name,id}); openE(name); }
async function addTie(name){
 const T=tieIndex();
 const near=Object.values(T.ix).filter(e=>e.name.toLowerCase()!==String(name).toLowerCase())
   .sort((a,b)=>b.hits.length-a.hits.length).slice(0,10).map(e=>e.name);
 const a=await sheet({title:'Somebody the recordings missed.',
  hint:'A debt, a grudge, a history that happened before any of this was written down. The vault keeps it apart from what it found on its own, and marks it as not having happened yet.',
  label:'Who, or what',ph:'A name',picks:near,
  pickhint:'The names the record leans on most — tap one, or write anybody.',
  label2:'And what stands between them (you can leave this blank)',
  ph2:'Owes them a debt they have never mentioned.',
  sub:'"Just me for now" hides it from everyone else’s screen. It still travels through the shared vault — this is a curtain, not a lock.'});
 if(!a) return;
 pushEdit('pc_tie',{op:'add',name,id:kid(),tie:a.text.slice(0,80),how:a.note.slice(0,200),
                    vis:a.vis,who:whoAmI()});
 openE(name);
}
function bondTap(el){
 const was=el.classList.contains('open');
 el.parentElement.querySelectorAll('.bond.open').forEach(x=>x.classList.remove('open'));
 if(!was) el.classList.add('open');
}
function qrow(t){
 return `<div class="li ${t.resolved?'done':''}" onclick="jump(${t.si},${t.t==null?'null':t.t})">
   <span class="dot ${t.u}"></span><p>${esc(t.q)}<span class="src">From <b>Session ${t.sn}</b>${t.resolved?' · answered':''}</span>
   ${EDIT?qedit(t):''}</p>
   <span class="tc ${t.t==null?'none':''}">${fmt(t.t)}</span></div>`;
}
/* The recordings turned a lot of small talk into Open Questions. Any of them
   can be reworded, marked answered, or put down — and putting one down never
   removes it from the night it came from. */
function qedit(t){
 const a=`${t.si},${t.ti}`;
 return `<span class="qed" onclick="event.stopPropagation()">
   <button onclick="qWord(${a})">reword</button>
   <button onclick="qDone(${a},${t.resolved?'false':'true'})">${t.resolved?'not answered after all':'we answered this'}</button>
   <button class="danger" onclick="qDrop(${a},true)">not really a question</button></span>`;
}
function qAt(si,ti){ const s=SESSIONS[si]; return s&&(s.threads||[])[ti]?{s,t:s.threads[ti]}:null; }
function qWord(si,ti){ const h=qAt(si,ti); if(!h)return;
 const v=prompt('Say it the way the table would say it.',h.t.q); if(v===null)return;
 qPush(h.s,ti,'q',v.trim()); }
function qDone(si,ti,v){ const h=qAt(si,ti); if(!h)return; qPush(h.s,ti,'resolved',!!v); }
function qDrop(si,ti,v){ const h=qAt(si,ti); if(!h)return;
 if(v&&!confirm('Put this one down?\n\nIt stops being counted as an open question. The night it came from keeps it, and you can always bring it back.'))return;
 qPush(h.s,ti,'hidden',!!v); }
function qPush(s,ti,field,value){
 pushEdit('session_field',{slug:s.slug,path:`threads.${ti}.${field}`,value});
 qRepaint();
}
function qRepaint(){
 TIES=null;
 if(VIEW==='codex'){ buildThreads(); buildCodex(); }
 else if(VIEW==='entity'&&LASTE) openE(LASTE);
 else if(VIEW==='session') openS(CUR);
}
/* Run a finger or a pointer across the bonds and one night lights up in all
   of them at once — so "who was he with on the eleventh?" is a question you
   answer by moving your hand, not by reading five rows and holding numbers
   in your head. The columns line up because every row draws the same nights
   in the same order; this is only possible because of that. */

/* ═══════ THE SHEET ═══════
   Every question a player is asked while building a character comes through
   here, so the order is the same every time: who is this for, then what is
   it. A phone gets it rising from the bottom edge under the thumb; a desktop
   gets it centred. Returns what was said, or null if they backed out. */
function sheet(o){
 return new Promise(res=>{
  const wrap=document.createElement('div'); wrap.className='sheet';
  const asks=o.vis!==false;
  let vis=o.vis&&o.vis!==true?o.vis:null;          /* editing keeps its answer */
  const big=!!o.multiline;
  wrap.innerHTML=`<div class="shbox" role="dialog" aria-modal="true">
    <h3>${esc(o.title)}</h3>
    ${o.hint?`<p class="shhint">${esc(o.hint)}</p>`:''}
    ${asks?`<div class="shstep">First — who is this for?</div>
      <div class="shvis">
       <button data-v="all"><b>Everyone at the table</b><span>It shows up on your page for the whole Kin.</span></button>
       <button data-v="mine"><b>Just me for now</b><span>Hidden from the others until you say otherwise.</span></button>
      </div>`:''}
    <div class="shf ${asks?'':'live'}" id="sh-f">
     <div class="shstep">${asks?'Then — ':''}${esc(o.label||'What is it?')}</div>
     ${big?`<textarea id="sh-t" rows="3" placeholder="${esc(o.ph||'')}"></textarea>`
          :`<input type="text" id="sh-t" placeholder="${esc(o.ph||'')}">`}
     ${(o.picks&&o.picks.length)?`<div class="shpick">${o.picks.map(x=>
        `<button type="button" data-p="${esc(x)}">${esc(x)}</button>`).join('')}</div>
       <p class="shsub">${esc(o.pickhint||'Tap one to start from it — you can rewrite every word, or ignore them entirely.')}</p>`:''}
     ${o.label2?`<div class="shstep">${esc(o.label2)}</div>
       <input type="text" id="sh-t2" placeholder="${esc(o.ph2||'')}">`:''}
     ${o.sub?`<p class="shsub">${esc(o.sub)}</p>`:''}
    </div>
    <div class="shbtn">
     <button id="sh-x">Cancel</button>
     <button class="go" id="sh-ok" ${asks&&!vis?'disabled':''}>${esc(o.ok||'Save')}</button>
    </div></div>`;
  document.body.appendChild(wrap);
  const t=wrap.querySelector('#sh-t'), t2=wrap.querySelector('#sh-t2'), ok=wrap.querySelector('#sh-ok');
  if(o.value) t.value=o.value;
  if(o.value2&&t2) t2.value=o.value2;
  const paint=()=>{
   wrap.querySelectorAll('.shvis button').forEach(b=>b.classList.toggle('on',b.dataset.v===vis));
   wrap.querySelector('#sh-f').classList.toggle('live',!asks||!!vis);
   ok.disabled=asks&&!vis;
  };
  wrap.querySelectorAll('.shvis button').forEach(b=>b.onclick=()=>{
   vis=b.dataset.v; paint(); t.focus(); });
  /* a suggestion writes itself into the box, where it can be argued with */
  wrap.querySelectorAll('.shpick button').forEach(b=>b.onclick=()=>{
   const v=b.dataset.p;
   t.value=t.value.trim()?t.value.replace(/\s*$/,'')+' '+v:v;
   wrap.querySelectorAll('.shpick button').forEach(x=>x.classList.toggle('on',x===b));
   t.focus(); t.setSelectionRange(t.value.length,t.value.length); });
  paint(); if(!asks||vis) setTimeout(()=>t.focus(),90);
  const done=v=>{ wrap.remove(); document.removeEventListener('keydown',key); res(v); };
  const save=()=>{ const text=t.value.trim();
   if(!text) return t.focus();
   done({text,note:t2?t2.value.trim():'',vis:vis||'all'}); };
  ok.onclick=save;
  wrap.querySelector('#sh-x').onclick=()=>done(null);
  wrap.onclick=e=>{ if(e.target===wrap) done(null); };
  if(!big) t.onkeydown=e=>{ if(e.key==='Enter'){ e.preventDefault(); save(); } };
  const key=e=>{ if(e.key==='Escape'){ e.stopPropagation(); done(null); } };
  document.addEventListener('keydown',key);
 });
}

/* ═══════ CLAIMING A SEAT ═══════
   Two chairs at the table have been empty since the vault was built. Tapping
   one is the whole of joining: a name, what they are, and the page exists. */
async function claimSlot(slot){
 const r=(CAMPAIGN.roster||[])[slot]; if(!r) return;
 const a=await sheet({title:'This seat is open.',
  hint:'Take it. You can change every word of this later — nothing here is set in stone, and nothing you write now has to be final.',
  label:"Your character's name",ph:'What the table will call them',
  label2:'And what they are',ph2:'Paladin, Rogue, Bladesinger Wizard…',
  vis:false,ok:'Claim it'});
 if(!a) return;
 const name=a.text.slice(0,60);
 if((CAMPAIGN.roster||[]).some((x,i)=>i!==slot&&x.name.toLowerCase()===name.toLowerCase())){
  alert('Somebody at this table is already called that. Try another name.'); return claimSlot(slot); }
 pushEdit('roster',{op:'claim',slot,name,cls:a.note.slice(0,60)||'Unknown',who:whoAmI()});
 buildParty(); openE(name);
}

/* ═══════ THE KIT ═══════
   The things a character carries. Free writing — but if what you write names
   something the campaign already knows about, the vault notices and joins the
   two up, so an item on a character page is a way into the Codex. */
let KLINK=null;
function kitLinker(){
 const ix=codexIndex();
 if(KLINK&&KLINK.n===Object.keys(ix).length) return KLINK;
 const names=[];
 Object.values(ix).forEach(e=>{
  [e.name,...e.aliases].forEach(a=>{ a=String(a||'').trim();
   if(a.length>=4) names.push([a,e.name]); }); });
 names.sort((a,b)=>b[0].length-a[0].length);      /* longest name wins the match */
 KLINK={n:Object.keys(ix).length,names};
 return KLINK;
}
/* escape first, then link — so a link can never be written by what someone types */
function kitText(txt){
 let out=esc(txt);
 for(const [alias,name] of kitLinker().names){
  const rx=new RegExp('(^|[^\\w>])('+alias.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')(?![\\w<])','i');
  if(rx.test(out)){
   const q=JSON.stringify(name).replace(/"/g,'&quot;');
   return out.replace(rx,(m,pre,hit)=>pre+`<a onclick="openE(${q})" title="Open ${esc(name)} in the codex">${hit}</a>`);
  }
 }
 return out;
}
const kid=()=>'k'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
