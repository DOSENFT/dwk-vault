function codexIndex(){
 const ix={};
 SESSIONS.forEach(s=>(s.entities||[]).forEach(e=>{
  let key=String(e.name||'').trim(); if(!key) return;
  const lk=key.toLowerCase();
  if((CODEX.hidden||[]).includes(lk)) return;
  if(CODEX.merges&&CODEX.merges[lk]) key=CODEX.merges[lk];
  const k0=key.toLowerCase();
  /* the transcriber sometimes wrote two people down as one card —
     "Ponsey / Talon". Splitting sends the card's whole history to both,
     without editing a syllable of what was recorded. */
  const sp=(CODEX.splits||{})[k0];
  (sp&&sp.length?sp:[key]).forEach(nm=>{
   const k=String(nm).toLowerCase();
   const rec=(ix[k]=ix[k]||{name:CODEX.renames?.[k]||nm,kind:e.kind,hits:[],aliases:new Set(),reveal:null});
   if(CODEX.kinds&&CODEX.kinds[k]) rec.kind=CODEX.kinds[k];
   if(e.alias) rec.aliases.add(e.alias);
   if(!sp&&String(e.name).toLowerCase()!==k) rec.aliases.add(e.name);
   if(e.reveal) rec.reveal=e.reveal;
   rec.hits.push({s,e});
  });
 }));
 Object.values(ix).forEach(r=>{ r.first=Math.min(...r.hits.map(h=>h.s.n)); });
 return ix;
}
