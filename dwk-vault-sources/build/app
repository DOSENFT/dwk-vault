 $('p-title').textContent=`Session ${s.n} — ${s.subtitle||s.title}`;
 if(url){
  if(LOADED!==i){ au.src=url; au.load(); LOADED=i; PENDING=null; }
  $('pb').disabled=false; note('Tap play, or tap any timecode');
 }else{
  au.removeAttribute('src'); LOADED=-1; $('pb').disabled=true;
  note(s.audio?'Audio not linked for this one yet':'No recording for this session');
 }
 $('p-time').textContent=`00:00:00 / ${fmt(s.durationSec)}`;
