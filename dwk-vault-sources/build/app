/* ═══════ THE SHARED VAULT ═══════
   Everything anyone changes becomes one line in a shared list of changes.
   The page loads the baked-in campaign, then replays that list on top of it.
   Nothing is ever overwritten and nothing can be deleted from the page —
   undoing something adds a line saying "ignore that one". Which means a
   player cannot break the campaign record, and any night of edits can be
   wound back later.

   No internet? Edits are held on this device and sent the next time the
   page opens with a connection. */

const SYNC={on:typeof SUPA!=='undefined'&&!!SUPA.url,state:'off',queue:[],last:0,seen:-1,flushing:false};
/* the campaign exactly as it was baked into this file — every replay starts here */
const BAKED=JSON.stringify({S:SESSIONS,C:CAMPAIGN,X:CODEX});
function resetToBaked(){
 const b=JSON.parse(BAKED);
 SESSIONS.length=0; b.S.forEach(x=>SESSIONS.push(x));
 Object.keys(CAMPAIGN).forEach(k=>delete CAMPAIGN[k]); Object.assign(CAMPAIGN,b.C);
 Object.keys(CODEX).forEach(k=>delete CODEX[k]);       Object.assign(CODEX,b.X);
}
try{ SYNC.queue=JSON.parse(localStorage.getItem('dwk-queue')||'[]'); }catch(e){ SYNC.queue=[]; }
const saveQ=()=>{ try{ localStorage.setItem('dwk-queue',JSON.stringify(SYNC.queue)); }catch(e){} };

function whoAmI(){
 let w=null; try{ w=localStorage.getItem('dwk-who'); }catch(e){}
 if(!w){
  w=(prompt("Before you change anything — who's editing?\n\nJust a first name. It gets written next to your changes so the table knows who did what.")||'').trim().slice(0,60);
  if(!w) w='someone';
  try{ localStorage.setItem('dwk-who',w); }catch(e){}
 }
 return w;
}
function setWho(){ try{ localStorage.removeItem('dwk-who'); }catch(e){} whoAmI(); paintSync(); }

const api=(path,opt={})=>fetch(SUPA.url+path,{...opt,
 headers:{apikey:SUPA.key,Authorization:'Bearer '+SUPA.key,...(opt.headers||{})}});

/* ── replay ───────────────────────────────────────────────────────────── */
function pcOf(name){ return (CAMPAIGN.roster||[]).find(r=>r.name.toLowerCase()===String(name).toLowerCase()); }
function artOf(name){
 const k=String(name).toLowerCase(); CODEX.art=CODEX.art||{};
 if(!CODEX.art[k]){ const pc=pcOf(name);
  CODEX.art[k]={hero:(pc&&pc.hero)||null,gallery:(pc&&pc.gallery)?pc.gallery.slice():[]}; }
 return CODEX.art[k];
}
function metaOf(name){
 const k=String(name).toLowerCase(); CODEX.meta=CODEX.meta||{};
 if(!CODEX.meta[k]){ const pc=pcOf(name);
  CODEX.meta[k]={sub:(pc&&pc.cls)||'',blurb:'',truename:(pc&&pc.realName)||''}; }
 return CODEX.meta[k];
}
/* What a player has put in themselves: the things they carry, and the three
   lines they have declared about where they come from. Both are keyed by
   name so they survive a rename the same way art and subtitles do. */
function kitOf(name){
 const k=String(name).toLowerCase(); CODEX.kit=CODEX.kit||{};
 if(!CODEX.kit[k]) CODEX.kit[k]=[];
 return CODEX.kit[k];
}
function sayOf(name){
 const k=String(name).toLowerCase(); CODEX.say=CODEX.say||{};
 if(!CODEX.say[k]) CODEX.say[k]={};
 return CODEX.say[k];
}
/* Marked "just mine" hides a line from the rest of the table on their
   screens. It is a curtain, not a lock — the line still travels through the
   shared vault, and the app says so plainly wherever the choice is offered.
   Nothing is ever deleted to hide it. */
function whoQuietly(){ try{ return localStorage.getItem('dwk-who')||''; }catch(e){ return ''; } }
function canSee(o){ if(!o||o.vis!=='mine') return true;
 const me=whoQuietly();                    /* never asks — reading a page must not interrogate you */
 return !!me && String(o.who||'')===me; }
/* "What I want" and "who have I heard of" were cut on purpose. One of them
   spoils what the table is supposed to find out at the table; the other
   invents a history the campaign never had. Where somebody comes from is
   background a new player genuinely needs, so that one stays. */
const SAYS=[['from','Where they come from']];
function applyEdit(ev){
 const p=ev.payload||{};
 switch(ev.kind){
  case 'session_field':{
   const s=SESSIONS.find(x=>x.slug===p.slug); if(!s)break;
   if(p.path==='party'){ s.party=p.value; break; }
   setPath(s,p.path,p.value); break; }
  case 'codex':{
   CODEX.kinds=CODEX.kinds||{}; CODEX.renames=CODEX.renames||{};
   CODEX.merges=CODEX.merges||{}; CODEX.hidden=CODEX.hidden||[];
   if(p.op==='kind')   CODEX.kinds[String(p.key||'').trim()]=p.value;
   const K=String(p.key||'').trim(), V=typeof p.value==='string'?p.value.trim():p.value;
   if(p.op==='rename') CODEX.renames[K]=V;
   if(p.op==='split'){ CODEX.splits=CODEX.splits||{};
    const names=(Array.isArray(p.value)?p.value:String(p.value).split('|'))
      .map(x=>String(x).trim()).filter(Boolean);
    if(names.length>1) CODEX.splits[K]=names; else delete CODEX.splits[K]; }
   if(p.op==='unsplit'){ CODEX.splits=CODEX.splits||{}; delete CODEX.splits[K]; }
   if(p.op==='merge')  CODEX.merges[K]=V;
   if(p.op==='hide'&&!CODEX.hidden.includes(String(p.key||'').trim())) CODEX.hidden.push(String(p.key||'').trim());
   if(p.op==='unhide') CODEX.hidden=CODEX.hidden.filter(k=>k!==p.key);
   if(p.op==='label'){ CAMPAIGN.kindLabels=CAMPAIGN.kindLabels||{}; CAMPAIGN.kindLabels[p.key]=p.value; }
   break; }
  case 'campaign':{
   if(p.path==='music'){
    CAMPAIGN.music=(CAMPAIGN.music||[]).filter(x=>x.subject.toLowerCase()!==String(p.subject).toLowerCase());
    if(p.value) CAMPAIGN.music.push({subject:p.subject,url:p.value});
    break; }
   setPath(CAMPAIGN,p.path,p.value); break; }
  case 'replace':  doReplace(p.find,p.repl,p.matchCase); break;
  case 'pc_meta':{ const m=metaOf(p.name); m[p.field]=p.value; break; }
  case 'pc_art':{
   const a=artOf(p.name);
   if(p.slot==='hero')        a.hero=p.url||null;
   else if(p.slot==='gallery')a.gallery.push(p.url);
   else if(p.slot==='ungallery') a.gallery=a.gallery.filter(g=>g!==p.url);
   break; }
  /* An empty seat becomes a person. The seat is addressed by its position in
     the roster the file was built with, so replaying the log on any device
     lands the same character in the same chair. */
  case 'roster':{
   const R=CAMPAIGN.roster||[];
   if(p.op==='claim'){
    const r=R[p.slot]; if(!r) break;
    r.name=String(p.name||'').trim()||r.name;
    r.cls=String(p.cls||'').trim()||r.cls;
    r.status='active'; r.note=''; r.claimedBy=p.who||'';
    break; }
   if(p.op==='field'){
    const r=R.find(x=>x.name.toLowerCase()===String(p.name).toLowerCase()); if(!r) break;
    r[p.field]=p.value; break; }
   break; }
  /* A found tie is read out of the recordings, so it is never edited — it is
     either shown or set aside, and either way the recording is untouched.
     A tie somebody adds by hand is stored separately and always marked. */
  case 'pc_tie':{
   const k=String(p.name||'').toLowerCase();
   if(p.op==='hide'||p.op==='unhide'){
    CODEX.tiehide=CODEX.tiehide||{};
    const a=CODEX.tiehide[k]=CODEX.tiehide[k]||[];
    if(p.op==='hide'){ if(!a.includes(p.key)) a.push(p.key); }
    else CODEX.tiehide[k]=a.filter(x=>x!==p.key);
    break; }
   CODEX.tieadd=CODEX.tieadd||{};
   const L=CODEX.tieadd[k]=CODEX.tieadd[k]||[];
   if(p.op==='add') L.push({id:p.id,name:p.tie,how:p.how||'',vis:p.vis||'all',who:p.who||''});
   if(p.op==='rm'){ const i=L.findIndex(x=>x.id===p.id); if(i>-1) L.splice(i,1); }
   break; }
  case 'pc_kit':{
   if(p.op==='say'){
    sayOf(p.name)[p.field]={v:p.value,vis:p.vis||'all',who:p.who||''};
    break; }
   const K=kitOf(p.name);
   if(p.op==='add'){
    K.push({id:p.id,text:p.text||'',note:p.note||'',img:p.img||null,
            vis:p.vis||'all',who:p.who||''});
    break; }
   const it=K.find(x=>x.id===p.id); if(!it) break;
   if(p.op==='edit'){ ['text','note','vis'].forEach(f=>{ if(p[f]!==undefined) it[f]=p[f]; }); break; }
   if(p.op==='img'){ it.img=p.img||null; break; }
   if(p.op==='rm'){ const i=K.indexOf(it); if(i>-1) K.splice(i,1); break; }
   break; }
 }
}

async function pullEdits(quiet){
 if(!SYNC.on) return false;
 try{
  const r=await api('/rest/v1/vault_edits?select=id,at,who,kind,payload&id=gt.'+BASE_EDIT+'&order=id.asc');
  if(!r.ok) throw new Error(r.status);
  const rows=await r.json();
  if(rows.length===SYNC.seen){ setSync('live'); return false; }
  const skip=new Set(rows.filter(x=>x.kind==='undo').map(x=>x.payload&&x.payload.target));
  /* always replay from the baked campaign, so the result never depends on
     what this particular device happened to do earlier in the evening */
  if(SYNC.seen>0) resetToBaked();
  rows.forEach(ev=>{ if(ev.kind==='undo'||skip.has(ev.id))return; try{applyEdit(ev);}catch(e){} });
  /* anything of ours still waiting to send stays visible to us */
  SYNC.queue.forEach(qd=>{ try{applyEdit(qd);}catch(e){} });
  SYNC.seen=rows.length; SYNC.last=rows.length?rows[rows.length-1].id:BASE_EDIT;
  SYNC.log=rows;
  setSync('live');
  return true;
 }catch(e){ setSync('offline'); return false; }
}

async function flush(){
 if(!SYNC.on||SYNC.flushing||!SYNC.queue.length) return;
 SYNC.flushing=true;
 try{
  const batch=SYNC.queue.slice(0,25);
  const r=await api('/rest/v1/vault_edits',{method:'POST',
   headers:{'Content-Type':'application/json',Prefer:'return=minimal'},
   body:JSON.stringify(batch)});
  if(!r.ok) throw new Error(await r.text());
  SYNC.queue=SYNC.queue.slice(batch.length); saveQ(); SYNC.seen=-1; setSync('live');
 }catch(e){ setSync('offline'); }
 SYNC.flushing=false;
 if(SYNC.queue.length) setTimeout(flush,8000);
}

/* the one and only way anything changes */
function pushEdit(kind,payload){
 applyEdit({kind,payload});
 CHANGES.push({kind,...payload});
 if(SYNC.on){ SYNC.queue.push({who:whoAmI(),kind,payload}); saveQ(); flush(); }
 markDirty(); paintSync();
}

function setSync(state){ SYNC.state=state; paintSync(); }
function paintSync(){
 const el=$('syncPill'); if(!el) return;
 if(!SYNC.on){ el.className='sync off'; el.textContent='This copy saves to a file'; return; }
 const q=SYNC.queue.length;
 if(q){ el.className='sync wait'; el.textContent=q+' change'+(q===1?'':'s')+' waiting to send'; }
 else if(SYNC.state==='live'){ el.className='sync live'; el.textContent='Shared · everyone sees this'; }
 else { el.className='sync off'; el.textContent='No connection — held on this device'; }
 el.title='Editing as '+(function(){try{return localStorage.getItem('dwk-who')||'—'}catch(e){return '—'}})()+'. Click to change.';
}

/* ── art ──────────────────────────────────────────────────────────────── */
function shrinkBlob(file,maxW,q){
 return new Promise((res,rej)=>{
  const fr=new FileReader();
  fr.onload=()=>{ const im=new Image();
   im.onload=()=>{ const sc=Math.min(1,maxW/im.width);
    const c=document.createElement('canvas');
    c.width=Math.round(im.width*sc); c.height=Math.round(im.height*sc);
    c.getContext('2d').drawImage(im,0,0,c.width,c.height);
    c.toBlob(b=>b?res(b):rej(new Error('could not read that image')),'image/jpeg',q); };
   im.onerror=()=>rej(new Error('could not read that image')); im.src=fr.result; };
  fr.onerror=()=>rej(new Error('could not read that file')); fr.readAsDataURL(file);
 });
}
const slugify=s=>String(s).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')||'x';
async function uploadArt(file,name,slot){
 const blob=await shrinkBlob(file,slot==='hero'?1800:1200,.80);
 const path=`pc/${slugify(name)}/${slot}-${Date.now()}-${Math.random().toString(36).slice(2,7)}.jpg`;
 const r=await api('/storage/v1/object/art/'+path,{method:'POST',
  headers:{'Content-Type':'image/jpeg'},body:blob});
 if(!r.ok) throw new Error(await r.text());
 return SUPA.url+'/storage/v1/object/public/art/'+path;
}

/* ═══════ MADE TO BEHAVE LIKE AN APP ═══════
   Installed to a home screen this opens with no browser furniture, so the
   phone's own controls have to work: lock screen, notification shade, car
   stereo, headphone buttons. And because the vault's whole idea is moments,
   the lock screen's skip buttons step between moments rather than between
   files — you can move through a night without unlocking the phone. */
const HOME='https://dosenft.github.io/dwk-vault/';
const STANDALONE=matchMedia('(display-mode: standalone)').matches||navigator.standalone===true;
const iOS=/iP(hone|ad|od)/.test(navigator.platform||'')||(/Mac/.test(navigator.platform||'')&&navigator.maxTouchPoints>1);
const ART=(()=>{ try{ return new URL('icon-512.png',location.href).href; }catch(e){ return ''; } })();

function mediaMeta(){
 if(!('mediaSession' in navigator))return;
 const s=SESSIONS[CUR]; if(!s)return;
 const b=RB[RI];
 try{
  navigator.mediaSession.metadata=new MediaMetadata({
   title:(b&&b.title)||s.subtitle||s.title,
   artist:`Session ${s.n} · ${s.pretty}`,
   album:(CAMPAIGN.title||'The Vault')+' — The Vault',
   artwork:ART?[{src:ART,sizes:'512x512',type:'image/png'}]:[]
  });
 }catch(e){}
}
function mediaPos(){
 if(!('mediaSession' in navigator)||!navigator.mediaSession.setPositionState)return;
 const d=au.duration;
 if(!isFinite(d)||d<=0)return;
 try{ navigator.mediaSession.setPositionState({duration:d,position:Math.min(au.currentTime,d),playbackRate:au.playbackRate||1}); }catch(e){}
}
if('mediaSession' in navigator){
 const H=(k,fn)=>{ try{ navigator.mediaSession.setActionHandler(k,fn); }catch(e){} };
 H('play',()=>startPlay());
 H('pause',()=>au.pause());
 H('stop',()=>{au.pause();});
 H('seekbackward',d=>seekTo(Math.max(0,au.currentTime-((d&&d.seekOffset)||15))));
 H('seekforward', d=>seekTo(au.currentTime+((d&&d.seekOffset)||15)));
 H('seekto',d=>{ if(!d)return; if(d.fastSeek&&au.fastSeek){ au.fastSeek(d.seekTime); return; } seekTo(d.seekTime); });
 H('previoustrack',()=>stepMoment(-1));
 H('nexttrack',    ()=>stepMoment(+1));
 au.addEventListener('play',   ()=>{ navigator.mediaSession.playbackState='playing'; mediaMeta(); mediaPos(); });
 au.addEventListener('pause',  ()=>{ navigator.mediaSession.playbackState='paused'; });
 au.addEventListener('loadedmetadata',mediaPos);
 au.addEventListener('seeked',mediaPos);
}
function stepMoment(dir){
 if(!RB.length)return;
 const k=(RI+dir+RB.length)%RB.length;
 paintBeat(k); if(REELON) scrollToBeat(k);
 hearBeat(k);
}

/* ── an offline shell, so the icon opens instantly and works in a basement ── */
if('serviceWorker' in navigator && location.protocol.startsWith('http')){
 addEventListener('load',()=>navigator.serviceWorker.register('sw.js').catch(()=>{}));
}

/* ── the one trap worth guarding: a copy saved to a phone can never play ── */
function rescueNote(){
 const el=$('h-offline'); if(!el)return;
 if(LOCALFILE){
  el.innerHTML=`<div class="offline"><b>This is a saved copy, so the recordings cannot play.</b>
   A downloaded file is not allowed to reach out and fetch them. Everything else here works.
   <a class="offlink" href="${HOME}">Open the live vault &#8599;</a></div>`;
  return;
 }
 let hid=false; try{ hid=localStorage.getItem('dwk-nohint')==='1'; }catch(e){}
 if(STANDALONE||hid){ el.innerHTML=''; return; }
 if(DEFER){
  el.innerHTML=`<div class="offline">Put this on your home screen and it opens like an app —
   full screen, and the lock-screen controls work.
   <button class="offlink" onclick="doInstall()">Add to home screen</button>
   <button class="offdim" onclick="hideHint()">no thanks</button></div>`;
 }else if(iOS){
  el.innerHTML=`<div class="offline">On iPhone or iPad, tap <b>Share</b> then <b>Add to Home Screen</b> —
   it opens full screen after that, and the lock-screen controls work.
   <button class="offdim" onclick="hideHint()">got it</button></div>`;
 }else el.innerHTML='';
}
let DEFER=null;
addEventListener('beforeinstallprompt',e=>{ e.preventDefault(); DEFER=e; rescueNote(); });
function doInstall(){ if(!DEFER)return; DEFER.prompt(); DEFER.userChoice.finally(()=>{ DEFER=null; hideHint(); }); }
function hideHint(){ try{ localStorage.setItem('dwk-nohint','1'); }catch(e){} const el=$('h-offline'); if(el)el.innerHTML=''; }

function repaint(){
 buildCodex(); buildThreads(); buildListen();
 if(VIEW==='session') openS(CUR);
 else if(VIEW==='entity') openE($('e-name').textContent);
 else if(VIEW==='score') buildScore();
}

function measureMast(){
 const m=document.querySelector('.mast');
 if(m) document.documentElement.style.setProperty('--masth',m.offsetHeight+'px');
}
measureMast(); addEventListener('resize',measureMast);

setAtmos('home');
load(0); buildCodex(); buildThreads(); buildListen(); rescueNote();
paintSync();
if(SYNC.on){
 pullEdits().then(fresh=>{ if(fresh) repaint(); flush(); });
 /* the table is six people on six phones; check back quietly while nobody
    is mid-sentence in an edit box */
 setInterval(()=>{ if(!EDIT) pullEdits().then(f=>{ if(f) repaint(); }); },45000);
 addEventListener('online',flush);
 addEventListener('visibilitychange',()=>{ if(!document.hidden&&!EDIT)
   pullEdits().then(f=>{ if(f) repaint(); }); });
}
