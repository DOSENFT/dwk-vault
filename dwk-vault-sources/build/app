    known('npc').concat(known('faction')).slice(0,12),
    'The names the recordings come back to most. Tap one, or write somebody the vault has never met.']}[field];
 const a=await sheet({title:ask[0],hint:ask[1],label:'In their words',multiline:true,
  picks:ask[2],pickhint:ask[3],
  ph:'',value:cur.v||'',vis:cur.v?(cur.vis||'all'):true,
  sub:'This is yours until it happens at the table. The vault marks it as such and takes the mark off the night it does.'});
 if(!a) return;
