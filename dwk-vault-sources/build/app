  label:'The thing itself',ph:'A chipped shortsword, my father’s',
  label2:'And why it matters (you can leave this blank)',ph2:'He never taught me to use it.',
  sub:'"Just me for now" hides it from everyone else’s screen. It still travels through the shared vault — this is a curtain, not a lock.'});
 if(!a) return;
 pushEdit('pc_kit',{op:'add',name,id:kid(),text:a.text.slice(0,160),note:a.note.slice(0,400),
                    vis:a.vis,who:whoAmI()});
